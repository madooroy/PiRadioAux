[Unit]
Description=PiRadio preset page
After=network-online.target mpd.service
Wants=network-online.target mpd.service

[Service]
User=piradio
WorkingDirectory=/opt/piradio
# Holds PIRADIO_NAME, the name shown on the page (written by install.sh).
EnvironmentFile=-/etc/default/piradio
ExecStart=/usr/bin/python3 /opt/piradio/app.py
# Allows serving on port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
