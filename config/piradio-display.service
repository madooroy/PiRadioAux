[Unit]
Description=PiRadio screen and buttons (Pimoroni Display HAT Mini)
# No After=piradio.service: that waits for the network, and the screen should light
# up ("Starting...") early in boot. display.py copes with the page not answering yet.
Wants=piradio.service

[Service]
User=piradio
# Access to the pins (buttons, light) and to SPI (the screen).
SupplementaryGroups=gpio spi
WorkingDirectory=/opt/piradio
# PIRADIO_NAME and PIRADIO_DISPLAY_FLIP (written by install.sh).
EnvironmentFile=-/etc/default/piradio
ExecStart=/usr/bin/python3 /opt/piradio/display.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
